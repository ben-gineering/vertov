[Unit]
Description=Vertov GUI (NiceGUI web interface)
After=network.target redis-server.service

[Service]
ExecStart=/home/pi/vertov/gui/.venv/bin/python3 /home/pi/vertov/gui/main.py
WorkingDirectory=/home/pi/vertov/gui
User=pi
Group=pi
Environment=CINEMATE_REDIS_HOST=localhost
Environment=CINEMATE_REDIS_PORT=6379
Environment=CINEMATE_MJPEG_URL=http://10.0.0.188:8000/stream
Environment=ZYNTHIAN_HOST=10.40.0.10
Environment=ZYNTHIAN_OSC_PORT=1370
SyslogIdentifier=vertov-gui
TimeoutStopSec=5
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
