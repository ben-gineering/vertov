# PhantomX Reactor Robot Arm - ROS 2 Development Container
# ROS 2 Humble with RViz + X11 support for Sway/Wayland
#
# Build:
#   docker build -f Dockerfile.robotarm -t phantomx_robotarm:humble .
#
# Run with X11:
#   ./run_robotarm_rviz.sh

FROM ros:humble

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install GUI dependencies for RViz and X11/Wayland support
RUN apt-get update && apt-get install -y --no-install-recommends \
    # X11 libraries (required for RViz GUI under XWayland)
    libx11-xcb1 \
    libxkbcommon-x11-0 \
    libxcb-dri3-0 \
    libxcb-present0 \
    libxcb-randr0 \
    libxcb-render0 \
    libxcb-shape0 \
    libxcb-sync1 \
    libxcb-xfixes0 \
    libxcb1 \
    libxext6 \
    libxft2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    # Qt5 dependencies (RViz is Qt-based)
    libqt5gui5 \
    libqt5widgets5 \
    libqt5x11extras5 \
    qtbase5-dev \
    # OpenGL for 3D rendering
    libgl1-mesa-glx \
    libegl1-mesa \
    libglu1-mesa \
    # ROS 2 packages for robot visualization
    ros-humble-xacro \
    ros-humble-joint-state-publisher \
    ros-humble-joint-state-publisher-gui \
    ros-humble-robot-state-publisher \
    ros-humble-rviz2 \
    ros-humble-launch-testing-ament-cmake \
    ros-humble-tf2-tools \
    ros-humble-tf-transformations \
    # Python dependencies
    python3-pip \
    python3-serial \
    python3-yaml \
    # Development tools
    vim \
    curl \
    git \
    sudo \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create non-root user (optional but recommended)
ARG USERNAME=ros
ARG USER_UID=1000
ARG USER_GID=$USER_UID

RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m $USERNAME \
    && echo "$USERNAME ALL=(root) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Switch to non-root user
USER $USERNAME

# Source ROS 2 environment
RUN echo "source /opt/ros/humble/setup.bash" >> /home/$USERNAME/.bashrc

# Set workspace directory
WORKDIR /home/$USERNAME/ros2_ws

# Default command
CMD ["bash"]
